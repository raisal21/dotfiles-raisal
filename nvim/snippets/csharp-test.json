      "    // Arrange",
      "    var value = ${3:true};",
      "",
      "    // Act",
      "    var result = await Task.FromResult(value);",
      "",
      "    // Assert",
      "    Assert.True(result);",
      "    $0",
      "}"
    ],
    "description": "Create an async xUnit fact"
  },
