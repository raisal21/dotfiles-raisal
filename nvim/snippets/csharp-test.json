{
  "xUnit test class": {
    "prefix": "xunitclass",
    "body": [
      "public sealed class ${1:Service}Tests",
      "{",
      "    private readonly ${2:Service} _sut = new();",
      "",
      "    $0",
      "}"
    ],
    "description": "Create an xUnit test class"
  },
  "xUnit fact": {
    "prefix": "xunitfact",
    "body": [
      "[Fact]",
      "public void ${1:MethodName}_Should_${2:ExpectedBehavior}()",
      "{",
      "    // Arrange",
      "    var value = ${3:42};",
      "",
      "    // Act",
      "    var result = value;",
      "",
      "    // Assert",
      "    Assert.Equal(${4:42}, result);",
      "    $0",
      "}"
    ],
    "description": "Create an xUnit fact with Arrange/Act/Assert"
  },
