    { "action": "shell", "resource": "git grep *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-list *", "effect": "allow" },
    { "action": "shell", "resource": "git for-each-ref *", "effect": "allow" },
    { "action": "shell", "resource": "git name-rev *", "effect": "allow" },
    { "action": "shell", "resource": "git diff-tree *", "effect": "allow" },
    { "action": "shell", "resource": "python3 -m json.tool *", "effect": "allow" },
    { "action": "shell", "resource": "python -m json.tool *", "effect": "allow" },
    { "action": "shell", "resource": "python3 -m py_compile *", "effect": "allow" },
    { "action": "shell", "resource": "python -m py_compile *", "effect": "allow" },
    { "action": "shell", "resource": "python3 --version", "effect": "allow" },
    { "action": "shell", "resource": "python3 -V", "effect": "allow" },
    { "action": "shell", "resource": "python --version", "effect": "allow" },
    { "action": "shell", "resource": "python -V", "effect": "allow" },
    { "action": "shell", "resource": "find * -delete*", "effect": "deny" },
    { "action": "shell", "resource": "find * -exec *", "effect": "deny" },
    { "action": "shell", "resource": "find * -execdir *", "effect": "deny" },
    { "action": "shell", "resource": "find * -ok *", "effect": "deny" },
    { "action": "shell", "resource": "find * -okdir *", "effect": "deny" },
    { "action": "shell", "resource": "fd * -x *", "effect": "deny" },
    { "action": "shell", "resource": "fd * -X *", "effect": "deny" },
    { "action": "shell", "resource": "fd * --exec *", "effect": "deny" },
    { "action": "shell", "resource": "fd * --exec-batch *", "effect": "deny" },
    { "action": "shell", "resource": "* > *", "effect": "deny" },
    { "action": "shell", "resource": "* >> *", "effect": "deny" },
    { "action": "shell", "resource": "* | tee *", "effect": "deny" },
    { "action": "shell", "resource": "tee *", "effect": "deny" }
  ],
  "agents": {
    "build": {
      "model": "openai/gpt-5.6-luna#max"
    },
    "plan": {
      "model": "openai/gpt-6-astra#medium"
    },
    "general": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna#max"
    },
    "explore": {
      "mode": "all",
      "model": "openai/gpt-5.6-luna#max",
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "allow" }
      ]
    },
    "research": {
      "description": "Research agent: fetches official docs, API references, and best practices from the web. Read-only, web-heavy, no file modifications.",
      "mode": "subagent",
      "system": "{file:/home/raisal/.config/opencode/prompts/research.md}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },
    "brainstorm": {
      "description": "Ideas partner: explore possibilities, tradeoffs, alternatives. Discuss articles, designs, and approaches. Read-only — never writes code or implementation plans.",
      "mode": "primary",
      "model": "openai/gpt-6-astra#medium",
      "system": "{file:/home/raisal/.config/opencode/prompts/brainstorm.md}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "commands": {
    "react-doctor": {
      "description": "Run React Doctor analysis (lint, dead code, a11y, bundle, architecture)",
      "template": "Run react-doctor on this project: execute `npx -y react-doctor@latest . --verbose` and report the health score (0-100). List any critical issues found — especially security, performance, and correctness problems. If this is after code changes, use `--diff` flag instead to check for regressions."
    }
  },
  "mcp": {
    "servers": {
      "bm25": {
        "type": "local",
        "command": ["node", "/home/raisal/.config/opencode/bm25-mcp/server.mjs"],
        "disabled": false
      },
      "context7": {
        "type": "local",
        "command": ["npx", "-y", "@upstash/context7-mcp"],
        "environment": {
          "CTX7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "disabled": false
      },
      "microsoft-learn": {
        "type": "remote",
        "url": "https://learn.microsoft.com/api/mcp",
        "disabled": true
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
        "disabled": true
      }
    }
  },
  "plugins": [
    "@tarquinen/opencode-dcp@3.2.0"
  ]
}
