{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "explore",
  "permission": {
    "edit": "ask",
    "write": "ask",
    "bash": {
      "*": "ask",
      "ls": "allow", "ls *": "allow",
      "eza": "allow", "eza *": "allow",
      "tree": "allow", "tree *": "allow",
      "cat *": "allow",
      "bat *": "allow",
      "batcat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "fd *": "allow",
      "which *": "allow",
      "pwd": "allow",
      "stat *": "allow",
      "file *": "allow",
      "du *": "allow",
      "df": "allow", "df *": "allow",
      "jq *": "allow",
      "ps": "allow", "ps *": "allow",
      "lsof *": "allow",
      "ss": "allow", "ss *": "allow",
      "netstat *": "allow",
      "ip *": "allow",
      "ifconfig": "allow", "ifconfig *": "allow",
      "free": "allow", "free *": "allow",
      "vmstat *": "allow",
      "nproc": "allow",
      "lscpu": "allow",
      "lsblk": "allow", "lsblk *": "allow",
      "uptime": "allow",
      "whoami": "allow",
      "id": "allow", "id *": "allow",
      "hostname": "allow", "hostname *": "allow",
      "uname": "allow", "uname *": "allow",
      "date": "allow", "date *": "allow",
      "env": "allow",
      "printenv": "allow", "printenv *": "allow",
      "realpath *": "allow",
      "readlink *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "diff *": "allow",
      "cmp *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "column *": "allow",
      "comm *": "allow",
      "xxd *": "allow",
      "od *": "allow",
      "hexdump *": "allow",
      "strings *": "allow",
      "ag *": "allow",
      "ack *": "allow",
      "whereis *": "allow",
      "type *": "allow",
      "ldd *": "allow",
      "nm *": "allow",
      "objdump *": "allow",
      "cal": "allow", "cal *": "allow",
      "git status": "allow", "git status *": "allow",
      "git diff": "allow", "git diff *": "allow",
      "git log": "allow", "git log *": "allow",
      "git show *": "allow",
      "git branch": "allow", "git branch *": "allow",
      "git remote *": "allow",
      "git stash list *": "allow",
      "git tag *": "allow",
      "git describe *": "allow",
      "git rev-parse *": "allow",
      "git blame *": "allow",
      "git ls-files *": "allow",
      "git reflog *": "allow",
      "git shortlog *": "allow",
      "git cat-file *": "allow",
      "git ls-tree *": "allow",
      "git grep *": "allow",
      "git rev-list *": "allow",
      "git for-each-ref *": "allow",
      "git name-rev *": "allow",
      "git diff-tree *": "allow",
      "python3 -m json.tool *": "allow",
      "python -m json.tool *": "allow",
      "python3 -m py_compile *": "allow",
      "python -m py_compile *": "allow",
      "python3 --version": "allow",
      "python3 -V": "allow",
      "python --version": "allow",
      "python -V": "allow",
      "find * -delete*": "deny",
      "find * -exec *": "deny",
      "find * -execdir *": "deny",
      "find * -ok *": "deny",
      "find * -okdir *": "deny",
      "fd * -x *": "deny",
      "fd * -X *": "deny",
      "fd * --exec *": "deny",
      "fd * --exec-batch *": "deny",
      "* > *": "deny",
      "* >> *": "deny",
      "* | tee *": "deny",
      "tee *": "deny"
    }
  },
  "agent": {
    "explore": {
      "mode": "all",
      "permission": {
        "bash": "deny"
      }
    },
    "research": {
      "description": "Research agent: fetches official docs, API references, and best practices from the web. Read-only, web-heavy, no file modifications.",
      "mode": "subagent",
      "prompt": "{file:/home/raisal/.config/opencode/prompts/research.md}",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": "deny"
      }
    },
    "brainstorm": {
      "description": "Ideas partner: explore possibilities, tradeoffs, alternatives. Discuss articles, designs, and approaches. Read-only — never writes code or implementation plans.",
      "mode": "primary",
      "prompt": "{file:/home/raisal/.config/opencode/prompts/brainstorm.md}",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": "deny"
      }
    }
  },
  "command": {
    "react-doctor": {
      "description": "Run React Doctor analysis (lint, dead code, a11y, bundle, architecture)",
      "template": "Run react-doctor on this project: execute `npx -y react-doctor@latest . --verbose` and report the health score (0-100). List any critical issues found — especially security, performance, and correctness problems. If this is after code changes, use `--diff` flag instead to check for regressions."
    }
  },
  "mcp": {
    "bm25": {
      "type": "local",
      "command": ["node", "/home/raisal/.config/opencode/bm25-mcp/server.mjs"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "env": {
        "CTX7_API_KEY": "${env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp",
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": false
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "vim"
  ]
}
