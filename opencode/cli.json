{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "cursor"
  },
  "keybinds": {
    "which-key.toggle": "<leader>k"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "markdown": "rendered",
    "image_preview": false,
    "permissions": "autoaccept"
  },
  "tabs": {
    "mode": "auto"
  }
}
